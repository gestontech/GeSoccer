# ==========================================
# GeSoccer - Environment Variables
# ==========================================

# Client API proxy.
# Public URL used by the Expo application.
EXPO_PUBLIC_GESOCCER_API_URL=https://ge-soccer.vercel.app/api/football

# Server-only API-Football secret.
# NEVER put the real key in the Expo application.
API_FOOTBALL_KEY=your_api_football_key_here
