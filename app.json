{
  "expo": {
    "name": "GeSoccer",
    "slug": "gesoccer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "gesoccer",

    "icon": "./assets/icon.png",

    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4B842F"
    },

    "ios": {
      "bundleIdentifier": "com.gesoccer.app",
      "supportsTablet": true
    },

    "android": {
      "package": "com.gesoccer.app"
    },

    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
