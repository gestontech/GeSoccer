{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/football.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/football",
      "destination": "/api/football.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
